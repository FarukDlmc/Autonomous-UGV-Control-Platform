<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Balkar GCS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="gcs-shell">

        <!-- Sidebar -->
        <aside class="gcs-sidebar">
            <div class="gcs-brand">
                <div class="gcs-brand-icon">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="40" height="40" rx="8" fill="#1a2a4a" />
                        <rect x="4" y="4" width="32" height="32" rx="6" fill="#1e3a6e" />
                        <path d="M12 20 Q20 10 28 20 Q20 30 12 20Z" fill="#4a9eff" opacity="0.8" />
                        <circle cx="20" cy="20" r="4" fill="#7ec8ff" />
                        <rect x="8" y="28" width="24" height="3" rx="1.5" fill="#4a9eff" opacity="0.5" />
                    </svg>
                </div>
                <span class="gcs-brand-name">BALKAR GCS</span>
            </div>

            <nav class="gcs-nav">
                <a href="@Url.Action("Dashboard", "Home")" class="gcs-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <span class="gcs-nav-icon">
                        <!-- Dashboard icon -->
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="3" width="7" height="8" rx="1.5" fill="currentColor" opacity="0.9" />
                            <rect x="14" y="3" width="7" height="5" rx="1.5" fill="currentColor" opacity="0.7" />
                            <rect x="14" y="12" width="7" height="9" rx="1.5" fill="currentColor" opacity="0.9" />
                            <rect x="3" y="15" width="7" height="6" rx="1.5" fill="currentColor" opacity="0.7" />
                        </svg>
                    </span>
                    <span class="gcs-nav-label">DASHBOARD</span>
                </a>

                <a href="@Url.Action("AIVision", "Home")" class="gcs-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AiVision" ? "active" : "")">
                    <span class="gcs-nav-icon">
                        <!-- AI Vision icon -->
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="2" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2" fill="none" />
                            <rect x="16" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2" fill="none" />
                            <rect x="2" y="16" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2" fill="none" />
                            <rect x="16" y="16" width="6" height="6" rx="1" stroke="currentColor" stroke-width="2" fill="none" />
                            <circle cx="12" cy="12" r="3" fill="currentColor" />
                            <circle cx="12" cy="12" r="5.5" stroke="currentColor" stroke-width="1.5" fill="none" />
                        </svg>
                    </span>
                    <span class="gcs-nav-label">AI VISION</span>
                </a>

                <a href="@Url.Action("Telemetry", "Home")" class="gcs-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Telemetry" ? "active" : "")">
                    <span class="gcs-nav-icon">
                        <!-- Telemetry / vehicle icon -->
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="2" y="10" width="20" height="8" rx="3" fill="currentColor" opacity="0.3" />
                            <rect x="4" y="8" width="16" height="7" rx="2" fill="currentColor" opacity="0.7" />
                            <rect x="7" y="6" width="10" height="5" rx="1.5" fill="currentColor" />
                            <circle cx="7" cy="18" r="2.5" fill="currentColor" />
                            <circle cx="7" cy="18" r="1.2" fill="#1a1f2e" />
                            <circle cx="17" cy="18" r="2.5" fill="currentColor" />
                            <circle cx="17" cy="18" r="1.2" fill="#1a1f2e" />
                        </svg>
                    </span>
                    <span class="gcs-nav-label">TELEMETRY</span>
                </a>

                <a href="@Url.Action("SystemLogs", "Home")" class="gcs-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SystemLogs" ? "active" : "")">
                    <span class="gcs-nav-icon">
                        <!-- System Logs / database icon -->
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <ellipse cx="12" cy="6" rx="8" ry="3" fill="currentColor" />
                            <path d="M4 6v4c0 1.657 3.582 3 8 3s8-1.343 8-3V6" stroke="currentColor" stroke-width="0" fill="currentColor" opacity="0.6" />
                            <path d="M4 10v4c0 1.657 3.582 3 8 3s8-1.343 8-3v-4" fill="currentColor" opacity="0.4" />
                            <path d="M4 14v4c0 1.657 3.582 3 8 3s8-1.343 8-3v-4" fill="currentColor" opacity="0.25" />
                        </svg>
                    </span>
                    <span class="gcs-nav-label">SYSTEM LOGS</span>
                </a>

                <a href="@Url.Action("ControlPanel", "Home")" class="gcs-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ControlPanel" ? "active" : "")">
                    <span class="gcs-nav-icon">
                        <!-- Control Panel / gear icon -->
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M12 1.5l1.5 2.598a5.5 5.5 0 011.5.866l2.598-1.5 2 3.464-2.598 1.5a5.5 5.5 0 010 1.732l2.598 1.5-2 3.464-2.598-1.5a5.5 5.5 0 01-1.5.866L12 16.5l-1.5-2.598a5.5 5.5 0 01-1.5-.866L6.402 14.536l-2-3.464 2.598-1.5a5.5 5.5 0 010-1.732L4.402 6.34l2-3.464 2.598 1.5a5.5 5.5 0 011.5-.866L12 1.5zM12 9a3 3 0 100 6 3 3 0 000-6z"
                                  fill="currentColor" />
                        </svg>
                    </span>
                    <span class="gcs-nav-label">CONTROL PANEL</span>
                </a>
            </nav>
        </aside>

        <!-- Main area -->
        <div class="gcs-main">
            <!-- Top bar -->
            <header class="gcs-topbar">
                <div class="gcs-topbar-inner"></div>
            </header>

            <!-- Content -->
            <main class="gcs-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- jQuery, Bootstrap JS vs. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Alt sayfaların kendi JS'lerini buraya basması için alan -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
